{
  "name": "@vasugrover/hono-openapi",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "OpenAPI utilities, helpers, and schemas for Hono framework with Zod validation",
  "license": "MIT",
  "homepage": "https://github.com/itsvasugrover/hono-openapi#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsvasugrover/hono-openapi.git"
  },
  "bugs": {
    "url": "https://github.com/itsvasugrover/hono-openapi/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "hono",
    "openapi",
    "zod",
    "validation",
    "api",
    "rest",
    "swagger",
    "schemas",
    "typescript"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "src"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "bunx biome lint .",
    "format": "bunx biome format --write .",
    "check": "bunx biome check --write .",
    "ci:check": "bunx biome ci .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@hono/zod-openapi": "^1.2.0",
    "@vasugrover/http-status": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@types/bun": "latest",
    "@vasugrover/biome-config": "^1.0.0",
    "@vasugrover/typescript-config": "^1.0.0"
  }
}
